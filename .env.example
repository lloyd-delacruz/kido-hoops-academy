# Public URL of the deployed site (canonical URLs, sitemap, and the iMessage/WhatsApp link-preview image).
# On Vercel this is detected automatically; on other hosts it MUST be set or link previews won't show.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Optional: form backend endpoint (e.g. Formspree) that accepts JSON POSTs.
# Leave empty and the inquiry forms will validate but clearly say online booking isn't connected yet.
NEXT_PUBLIC_FORM_ENDPOINT=
